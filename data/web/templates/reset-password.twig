{% extends 'base.twig' %}

{% block navbar %}{% endblock %}

{% block content %}
<div class="td-login-topbar">
  <div class="td-login-theme-toggle form-check form-switch">
    <label class="form-check-label" for="dark-mode-toggle"><i class="bi bi-moon-fill"></i> Theme mode</label>
    <input class="form-check-input" type="checkbox" id="dark-mode-toggle">
  </div>
</div>

<div class="td-login-shell">
  <div class="td-login-panel">
    <aside class="td-login-brand">
      <img class="td-login-logo" src="/img/td-property-logo.jpeg" alt="TD Property Developers">
      <div>
        <p class="td-login-kicker">TD Property Developers</p>
        <h1>Account recovery</h1>
        <p class="td-login-copy">Request a secure password reset link or set a new password for your mail account.</p>
      </div>
      <div class="td-login-meta">
        <span><i class="bi bi-shield-lock-fill"></i> Secure reset</span>
        <span><i class="bi bi-envelope-check-fill"></i> Mail account</span>
      </div>
    </aside>

    <section class="td-login-card card">
      <div class="td-login-card-header">
        <div>
          <span class="td-login-eyebrow"><i class="bi bi-person-fill"></i> {{ lang.login.reset_password }}</span>
          <h2>{{ lang.login.reset_password }}</h2>
        </div>
      </div>
      <div class="card-body">
        {% if is_reset_token_valid %}
        <form method="post" autofill="off">
          <input type="hidden" name="token" value="{{ reset_token }}" />
          <div class="d-flex mt-3 td-login-field">
            <label class="visually-hidden" for="new_password">{{ lang.login.new_password }}</label>
            <div class="input-group">
              <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
              <input id="new_password" type="password" autocorrect="off" autocapitalize="none" class="form-control" name="new_password" placeholder="{{ lang.login.new_password }}" />
            </div>
          </div>
          <div class="d-flex mt-3 td-login-field">
            <label class="visually-hidden" for="new_password2">{{ lang.login.new_password_confirm }}</label>
            <div class="input-group">
              <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
              <input id="new_password2" type="password" autocorrect="off" autocapitalize="none" class="form-control" name="new_password2" placeholder="{{ lang.login.new_password_confirm }}" />
            </div>
          </div>

          <small id="mismatch_alert" class="text-danger d-none">{{ lang.login.password_mismatch }}</small>
          <div class="d-flex justify-content-between mt-4" style="position: relative">
            <button type="submit" class="btn btn-xs-lg btn-success w-100 mt-2 mx-auto td-login-submit" name="pw_reset">{{ lang.login.reset_password }}</button>
          </div>
        </form>
        {% elseif reset_token is null %}
        <form method="post" autofill="off">
          <div class="d-flex mt-3 td-login-field">
            <label class="visually-hidden" for="username">{{ lang.login.username }}</label>
            <div class="input-group">
              <div class="input-group-text"><i class="bi bi-person-fill"></i></div>
              <input id="username" type="text" autocorrect="off" autocapitalize="none" class="form-control" name="username" placeholder="{{ lang.login.username }}" />
            </div>
          </div>

          <div class="d-flex justify-content-between mt-4" style="position: relative">
            <button type="submit" class="btn btn-xs-lg btn-success w-100 mt-2 mx-auto td-login-submit" name="pw_reset_request">{{ lang.login.request_reset_password }}</button>
          </div>
        </form>
        {% else %}
        <p class="td-login-message">{{ lang.login.invalid_pass_reset_token|raw }}</p>
        <a class="btn btn-xs-lg btn-secondary w-100 mt-2 td-login-secondary" href="/">{{ lang.login.back_to_mailcow }}</a>
        {% endif %}
      </div>
    </section>
  </div>
</div>

<script type='text/javascript'>
  var csrf_token = '{{ csrf_token }}';
  var mailcow_cc_username = '{{ mailcow_cc_username }}';
</script>
{% endblock %}
